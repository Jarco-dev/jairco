model Group {
  id          Int      @id @default(autoincrement())
  guildId     Int
  name        String
  permissions BigInt   @default(0)
  createdAt   DateTime
  updatedAt   DateTime

  Guild Guild  @relation(fields: [guildId], references: [id])
  Roles Role[]
  Users User[]

  @@unique([guildId, name])
}
