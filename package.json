{
  "name": "jairco",
  "version": "1.12.0",
  "description": "The jairco discord bot",
  "author": "Jarco-dev",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/shared/presenter/discord/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "format": "biome format",
    "lint": "biome check",
    "type-check": "tsc --noEmit",
    "prisma": "prisma --config ./src/shared/infrastructure/persistence/prisma/prismaConfig.ts"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "inversify": "^8.2.3",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^22.20.1",
    "prisma": "^7.9.1",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
